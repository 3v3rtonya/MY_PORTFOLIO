# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/portfolio?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production: your Vercel URL. Dev: http://localhost:5173
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── CV file path (local fallback only — ignored when R2 is configured) ────────
CV_FILE_PATH=./static/Everton_Anyiro_CV.pdf

# ── Cloudflare R2 (object storage) ───────────────────────────────────────────
# Get these from: https://dash.cloudflare.com → R2 → Manage API tokens
# Leave blank to use local disk storage (dev only)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=portfolio-assets
# Enable public access on the bucket then paste the public URL here:
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
